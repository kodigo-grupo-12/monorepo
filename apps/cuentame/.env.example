# Config web del proyecto de Firebase (kodigo-grupo12).
# Copia este archivo como .env y llena los valores desde
# Firebase console > Configuracion del proyecto > General > Configuracion web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Solo para la web local: apunta la app a los emuladores de Auth y Firestore
# (pnpm emuladores) en vez del proyecto real de Firebase. Pages y el CI nunca
# definen esta variable.
# EXPO_PUBLIC_USAR_EMULADORES=1
