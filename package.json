{
  "name": "raiz",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-cuentame",
    "start": "turbo run start --filter=cuentame",
    "typecheck": "turbo run typecheck --filter=cuentame",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-cuentame \"pnpm exec vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^14.27.0",
    "turbo": "^2.7.4",
    "vitest": "^4.0.8"
  }
}
